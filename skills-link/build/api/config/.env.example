# Copy to .env (optional). If ENCRYPTION_KEY / HASH_PEPPER are missing they are
# generated automatically on first use and written to config/.env.
# ENCRYPTION_KEY must be 64 hex characters:  php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=
HASH_PEPPER=
# DB_HOST=127.0.0.1
# DB_NAME=skills_link
# DB_USER=root
# DB_PASS=
# UPLOAD_DIR=/path/outside/webroot/uploads
# BACKUP_DIR=/path/outside/webroot/backups
# BACKUP_KEEP=14   (how many automatic nightly backups to keep)
# ALLOWED_ORIGIN=http://localhost:4200
